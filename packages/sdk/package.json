{
  "name": "@openpartner/sdk",
  "version": "0.1.0",
  "description": "OpenPartner SDK. Browser client for click → identity stitching + Node server SDK for conversion events and attribution reads.",
  "type": "module",
  "main": "./dist/browser.cjs",
  "module": "./dist/browser.js",
  "types": "./dist/browser.d.ts",
  "exports": {
    ".": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "openpartner",
    "affiliate",
    "attribution",
    "referral",
    "partner",
    "sdk"
  ],
  "homepage": "https://github.com/getcoherence/openpartner/tree/main/packages/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getcoherence/openpartner.git",
    "directory": "packages/sdk"
  },
  "license": "MIT",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "jsdom": "^29.0.2",
    "tsup": "^8.5.1",
    "typescript": "5.4.5",
    "vitest": "^1.6.0"
  }
}
