{
  "name": "@openpartner/sdk",
  "version": "0.2.0",
  "description": "OpenPartner SDK. Browser client for click → identity stitching + Node server SDK for conversion events and attribution reads.",
  "type": "module",
  "main": "./dist/browser.cjs",
  "module": "./dist/browser.js",
  "types": "./dist/browser.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "require": {
        "types": "./dist/browser.d.cts",
        "default": "./dist/browser.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "server": [
        "./dist/server.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dist-global",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "openpartner",
    "affiliate",
    "attribution",
    "referral",
    "partner",
    "sdk"
  ],
  "homepage": "https://github.com/getcoherence/openpartner/tree/main/packages/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getcoherence/openpartner.git",
    "directory": "packages/sdk"
  },
  "license": "MIT",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "build:global": "tsup --config tsup.global.config.ts",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "jsdom": "^29.0.2",
    "tsup": "^9.0.0",
    "typescript": "6.0.3",
    "vitest": "^3.2.7"
  },
  "unpkg": "./dist-global/openpartner.js",
  "jsdelivr": "./dist-global/openpartner.js"
}
