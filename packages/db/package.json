{
  "name": "@openpartner/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OpenPartner database — Knex migrations, shared TypeScript types, export/import schema.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.migrate.json && node -e \"require('fs').writeFileSync('dist-migrate/package.json', JSON.stringify({type:'commonjs'}))\"",
    "migrate": "tsx scripts/migrate.ts latest",
    "migrate:rollback": "tsx scripts/migrate.ts rollback",
    "migrate:make": "tsx scripts/migrate.ts make",
    "migrate:status": "tsx scripts/migrate.ts status",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "knex": "^3.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@types/pg": "^8.23.1",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.12"
  }
}
