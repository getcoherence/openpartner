{
  "name": "@openpartner/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OpenPartner database — Knex migrations, shared TypeScript types, export/import schema.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx node_modules/knex/bin/knex.js migrate:latest --knexfile knexfile.ts",
    "migrate:rollback": "tsx node_modules/knex/bin/knex.js migrate:rollback --knexfile knexfile.ts",
    "migrate:make": "tsx node_modules/knex/bin/knex.js migrate:make --knexfile knexfile.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "knex": "^3.1.0",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.0",
    "typescript": "5.4.5",
    "vitest": "^1.6.0"
  }
}
