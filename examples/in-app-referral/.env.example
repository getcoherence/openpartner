# Your tenant's API base (see docs/headless-referral.md#base-url).
#   OpenPartner Cloud:  https://app.openpartner.dev/api/t/<tenant-slug>
#   Custom domain:      https://<your-domain>/api
#   Self-hosted:        http://localhost:4601
OPENPARTNER_API_URL=https://app.openpartner.dev/api/t/your-tenant-slug

# A SCOPED key (setup.mjs mints one). Server-side only.
OPENPARTNER_API_KEY=op_replace_me

# The referral program's id (setup.mjs creates one).
OPENPARTNER_PROGRAM_ID=

# Share links are <this>/<linkKey>.
#   OpenPartner Cloud:  https://app.openpartner.dev/r/<tenant-slug>
#   Custom domain:      https://<your-domain>/r
#   Self-hosted:        your router origin + /r, e.g. http://localhost:4701/r
OPENPARTNER_SHARE_URL_BASE=https://app.openpartner.dev/r/your-tenant-slug

PORT=3000
