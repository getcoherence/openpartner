{
  "name": "openpartner",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source partner attribution and payouts. Full attribution, three-tier pricing, data portability.",
  "homepage": "https://openpartner.dev",
  "packageManager": "pnpm@9.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "eslint apps packages",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "migrate": "pnpm --filter @openpartner/db migrate",
    "migrate:rollback": "pnpm --filter @openpartner/db migrate:rollback",
    "migrate:make": "pnpm --filter @openpartner/db migrate:make",
    "dev:router": "pnpm --filter @openpartner/router dev",
    "dev:api": "pnpm --filter @openpartner/api dev",
    "dev:portal": "pnpm --filter @openpartner/portal dev"
  },
  "pnpm": {
    "overrides": {
      "proxy-addr": "2.0.8",
      "qs@>=6 <6.16.0": "^6.16.1",
      "form-data@>=4 <4.0.6": "^4.0.6",
      "brace-expansion@>=1 <1.1.21": "^1.1.21",
      "brace-expansion@>=5 <5.0.12": "^5.0.12",
      "js-yaml@>=4 <4.3.2": "^4.3.2",
      "postcss@>=8 <8.5.23": "^8.5.23",
      "nanoid@>=3 <3.3.12": "^3.3.12",
      "source-map-js@>=1 <1.2.2": "^1.2.2",
      "browserslist@>=4 <4.28.7": "^4.28.7",
      "undici@>=7 <7.29.1": "^7.29.1",
      "@babel/core@>=7 <7.29.6": "^7.29.6",
      "baseline-browser-mapping@>=2 <2.11.0": "^2.11.0",
      "body-parser@>=1 <1.20.9": "^1.20.9",
      "eslint-plugin-react-hooks>zod": "^4.6.7"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^25.9.9",
    "eslint": "9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
