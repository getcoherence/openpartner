{
  "name": "openpartner",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source partner attribution and payouts. Full attribution, three-tier pricing, data portability.",
  "homepage": "https://openpartner.dev",
  "packageManager": "pnpm@9.11.0",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "eslint apps packages",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "migrate": "pnpm --filter @openpartner/db migrate",
    "migrate:rollback": "pnpm --filter @openpartner/db migrate:rollback",
    "migrate:make": "pnpm --filter @openpartner/db migrate:make",
    "dev:router": "pnpm --filter @openpartner/router dev",
    "dev:api": "pnpm --filter @openpartner/api dev",
    "dev:portal": "pnpm --filter @openpartner/portal dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.7.0",
    "eslint": "9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "tsx": "^4.19.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^3.2.4"
  }
}
