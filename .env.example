# OpenPartner environment variables
# Copy to .env for local development

# Deployment mode — controls billing/payout code paths
# Values: selfhost | flat | revshare
OPENPARTNER_MODE=selfhost

# Tenancy mode — single tenant (self-host bootstrap) vs multi-tenant
# (hosted, /t/<slug>/... URL routing). Values: single | multi
# Self-host customers leave this at 'single'. Hosted operators set
# 'multi' and use POST /signup to provision tenants.
OPENPARTNER_TENANCY=single

# In-process scheduler: scheduled payouts (including real Stripe Connect
# transfers), commission auto-approve, usage reporting, Network sync, sweeps.
# docker-compose.prod.yml runs it unless this is 0. Anywhere else (pnpm dev,
# your own deploy) it runs only when this is 1. Exactly ONE api process may
# run it. See docs/deploy.md#scheduled-jobs.
OPENPARTNER_ENABLE_SCHEDULER=

# Database — privileged connection used by migrations, signup, the
# Stripe webhook handler, and the in-process scheduler. Bypasses RLS.
DATABASE_URL=postgres://openpartner:openpartner@localhost:5433/openpartner

# App-role connection string used by every tenant-scoped request: the
# openpartner_app role (not a superuser, no BYPASSRLS, doesn't own the
# tables), so Postgres row-level security applies.
#   OPENPARTNER_TENANCY=multi  REQUIRED. RLS is the tenant boundary, and the
#                              API refuses to start if this connection
#                              bypasses it. App-level tenantId filters alone
#                              don't isolate tenants.
#   OPENPARTNER_TENANCY=single optional. When unset, requests run as
#                              DATABASE_URL and RLS is bypassed, which is
#                              harmless with one tenant.
# Set it together with OPENPARTNER_APP_DB_PASSWORD.
DATABASE_URL_APP=

# Password used to provision the openpartner_app role on migrate. The
# 20260507020000_app_role.ts migration creates the role with this
# password (rotates it if the role already exists). Skipped with a
# notice if unset. Pair with DATABASE_URL_APP pointing at this role.
OPENPARTNER_APP_DB_PASSWORD=

# Service ports
ROUTER_PORT=4701
API_PORT=4601
PORTAL_PORT=5673

# First-party cookie domain for attribution stitching
# In production: set to your marketing apex (e.g. .yourdomain.com)
COOKIE_DOMAIN=localhost

# Bootstrap / headless admin bearer. Human admins sign in via the /install
# wizard (first run) or by receiving an emailed magic link. Keep this set
# for CI, scripts, and emergency access; rotate once human admins exist.
# Generate: node -e "console.log('op_' + require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=op_devonly_replace_me_with_64_hex_chars_before_any_real_use_xxxx

# Stripe. Required for the hosted tiers (flat / revshare). Optional for
# selfhost: leave blank to pay partners by hand, or set the key and the
# webhook secrets below to YOUR Stripe account to pay partners over Stripe
# Connect and ingest invoiced Stripe revenue via /webhooks/stripe
# (packages/sdk/README.md → Stripe).
STRIPE_SECRET_KEY=
# Webhook signing secrets. PREFERRED: set the two family-bound vars below so a
# secret from one Stripe "Event destination" can't authorize an event family
# from the other. Each accepts a comma-separated list (rotation / multiple
# endpoints).
#   _PLATFORM → Destination A: platform-account events
#               (checkout.*, customer.*, invoice.*, charge.*, payment_intent.*)
#               and transfer.* (we create Connect transfers with the
#               platform key, so those events fire on the platform account)
#   _CONNECT  → Destination B: connected-account events (account.updated)
STRIPE_WEBHOOK_SECRET_PLATFORM=
STRIPE_WEBHOOK_SECRET_CONNECT=
# LEGACY: single/combined secret used for BOTH families when the split vars
# above are unset (family enforcement is then OFF). Kept for back-compat;
# migrate to the split vars.
STRIPE_WEBHOOK_SECRET=
# UNUSED (legacy): no code reads this. Connect onboarding uses
# accounts.create + account links, not OAuth, so no client id is needed.
STRIPE_CONNECT_CLIENT_ID=

# OpenPartner Stripe App — HOSTED ONLY (flat / revshare). Hosted brands
# connect their own Stripe account (OAuth install) so its checkouts,
# invoices, refunds and promo codes drive attribution (docs/stripe-app.md).
# These are the keys of the app's OWN developer account — never the billing
# account above. A mode is offered in the portal only when both its secret
# key and client id are set. Self-host ignores all of these.
STRIPE_APP_SECRET_KEY=
STRIPE_APP_CLIENT_ID=
STRIPE_APP_SECRET_KEY_TEST=
STRIPE_APP_CLIENT_ID_TEST=
# Optional: the app's managed sandbox.
STRIPE_APP_SECRET_KEY_SANDBOX=
STRIPE_APP_CLIENT_ID_SANDBOX=
# Signing secrets of the app's Connect webhook endpoints (live, test mode,
# sandbox), comma-separated. URL: <portal>/api/webhooks/stripe-app.
STRIPE_APP_WEBHOOK_SECRET=
# Optional. Defaults to ${PORTAL_URL}/api/stripe-app/oauth/callback and must
# exactly match one of stripe-app/stripe-app.json's allowed_redirect_uris.
STRIPE_APP_REDIRECT_URI=

# --- "Continue with Google" sign-in (all tiers, optional) ---
# An OAuth client ID of type "Web application" from Google Cloud Console →
# APIs & Services → Credentials. Leave either blank and the Google button
# stays hidden; email + password and emailed links work regardless.
# Authorized redirect URI to register: ${PORTAL_URL}/api/auth/google/callback
# Network creators (/creator/login) use the same client and redirect URI; their
# Google sign-in also needs NETWORK_URL + NETWORK_ADMIN_API_KEY
# (docs/creator-sign-in.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override of that redirect URI (must match Google's list exactly).
GOOGLE_OAUTH_REDIRECT_URI=
# Until App Review publishes the app: the External test tab's live-mode
# install link, pasted whole (…/oauth/v2/chnlink_…/authorize?…). Only its path
# is used. Covers every mode unless STRIPE_APP_AUTHORIZE_URL_TEST/_SANDBOX
# overrides it. Unset = the public link (works only once published).
STRIPE_APP_AUTHORIZE_URL=
# Hosted plan prices. `STRIPE_SECRET_KEY=sk_test_... node
# apps/api/scripts/setup-stripe.mjs` creates them and prints these lines.
# Flat (Flex) base subscription price.
STRIPE_FLAT_PRICE_ID=
# Optional Flex metered price (1.5% of attributed GMV). Unset = base only.
STRIPE_FLAT_USAGE_PRICE_ID=
# Revshare metered price (3% of attributed GMV). Required for revshare checkout.
STRIPE_REVSHARE_USAGE_PRICE_ID=

# White-label add-on: monthly recurring price attached to the tenant's plan
# subscription. Enables the self-serve add-on toggle (admin → White label);
# the webhook mirrors its presence onto Tenant.whiteLabel.
STRIPE_WHITELABEL_ADD_ON_PRICE_ID=

# Hosted payout funding (docs/payout-funding.md). DEFAULT OFF. When '1',
# hosted Connect payouts route through funding batches: the brand's bank
# account (ACH, authorized in admin → Billing) is debited for the
# commission principal, and partner transfers post only after the payment
# settles. Leave unset until the staging matrix (§11) passes and counsel
# has reviewed the funding terms. Off = the fail-closed guard holds,
# hosted tenants use the manual payout rail, and the Billing card that
# collects the authorization stays hidden (new authorizations are refused).
HOSTED_FUNDING_ENABLED=

# Click velocity limits — clicks per window from the same ipHash + linkKey.
VELOCITY_MAX=20
VELOCITY_WINDOW_MS=60000

# (OPENPARTNER_BILLABLE_EVENT_TYPES_EXTRA is retired: each program declares
# its own revenue event types in the admin UI. See docs/platform-fee.md.)

# -- Outbound request guard (SSRF) --
# Applies to server-side webhook deliveries + partner postbacks. Destinations
# must resolve to public unicast IPs; the address is DNS-pinned before connect
# and redirects are never followed.
#
# Exact ports the server may connect to (comma-separated). Hosted deploys
# default to 80,443; self-host single-tenant defaults to no restriction. Set
# to widen for customers on non-standard ports (e.g. 80,443,8443). Not
# tenant-configurable.
OPENPARTNER_OUTBOUND_ALLOWED_PORTS=
# Self-host escape hatch: comma-separated CIDRs to allow despite being
# private/loopback (e.g. testing a webhook against a localhost service).
# Honored ONLY when OPENPARTNER_MODE=selfhost AND OPENPARTNER_TENANCY=single;
# set in any other mode and the app refuses to boot. CIDRs only, no hostnames.
OPENPARTNER_OUTBOUND_ALLOW_PRIVATE_CIDRS=

# Public portal URL. Required in production so CORS has an explicit
# origin allowlist (we refuse to boot with it empty). Defaults to
# localhost:5673 in dev.
PORTAL_URL=http://localhost:5673

# Optional: extra CORS origins beyond PORTAL_URL, comma-separated.
CORS_EXTRA_ORIGINS=

# -- Secret encryption at rest --
# 32-byte master key (hex or base64) used to encrypt SMTP passwords /
# Postmark tokens, Stripe App and Network tokens, partner payout details,
# outbound webhook signing secrets and partner postback URLs. REQUIRED in
# production; dev uses a fixed fallback with a warning so restarts keep
# decrypting. Changing it makes those unreadable: webhook endpoints then
# need their secret rotated, and partners re-enter payout details and
# postback URLs.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_ENCRYPTION_KEY=

# Mail for admin + partner invite / signin links.
#
# Preferred: configure from the admin Settings → Email delivery page
# (stored encrypted at rest in Config). The env vars below are
# fallbacks used only when UI config is empty — useful for hosted /
# managed tiers where the operator wants to force the transport.
#
#   SMTP_HOST + MAIL_FROM    → nodemailer SMTP (Gmail, SES, Mailgun,
#                              SendGrid, Postmark SMTP, Postfix, …)
#   POSTMARK_SERVER_TOKEN + MAIL_FROM → Postmark HTTP API
#   neither                  → stdout (dev only)
#
# MAIL_FROM must be quoted if it contains a display name, e.g.
#   MAIL_FROM="Acme Partners <partners@acme.com>"
MAIL_FROM=

# -- SMTP fallback --
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=

# -- Postmark (alternative) --
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound

# Optional: bearer token required to scrape /metrics. Leave blank and
# /metrics is open (fine on internal networks). Set it when /metrics is
# reachable from the public internet.
METRICS_TOKEN=

# -- Brand review / platform-ops console (hosted multi-tenant only) --
# New brand signups land in a review queue (approvalStatus='pending'):
# they can sign in and configure, but serve no clicks and can't invite
# partners until an operator approves. Self-host (single tenancy) is
# unaffected — the seeded brand is auto-approved.
#
# Comma-separated emails allowed to sign in to the ops console at
# /platform/login. Any listed email is upserted as a role='admin'
# PlatformAdmin on first magic-link verify — this is how a fresh install
# bootstraps its first operator. Additional operators are managed as
# PlatformAdmin rows. Leave blank on self-host.
PLATFORM_ADMIN_EMAILS=

# Country access (hosted multi-tenant only; docs/country-access.md). The
# list of countries the platform doesn't serve is an ops-console setting,
# not env. IP country comes from DB-IP's free country database, downloaded
# monthly into OPENPARTNER_GEOIP_DIR (default: the OS temp dir). To use your
# own GeoIP2/GeoLite2-Country .mmdb instead, point GEOIP_COUNTRY_DB at it.
OPENPARTNER_GEOIP_DIR=
GEOIP_COUNTRY_DB=

# Sanctions screening (hosted multi-tenant only; docs/sanctions-screening.md).
# A free subscription key from developer.trade.gov for the Consolidated
# Screening List API. Unset = nobody is screened and no payout is held for
# screening (logged once at the first attempt).
CSL_API_KEY=

# Where platform-ops notifications are emailed: "brand needs review" +
# approve/reject decisions, and billing lifecycle alerts (a tenant
# scheduling a cancellation, their subscription ending, dunning failures
# on their OpenPartner invoices). Sent via the platform mail transport
# (the MAIL_FROM / SMTP / Postmark fallback above), never a brand's own
# provider. Leave blank to skip ops email.
PLATFORM_OPS_EMAIL=

# Optional: URL of the OpenPartner Network coordinator. When set, hosted
# multi-tenant signups auto-register with the Network (admin still
# confirms via the magic link); self-host installs see a "Connect to
# Network" button under Settings → Network. Leave empty to opt out.
NETWORK_URL=

# -- White-label custom domains (hosted only) --
# Shared secret between the dedicated white-label edge (Phase-3 Caddy
# droplet) and the API. When set, a request carrying a matching
# X-OP-Edge-Token header may supply the tenant host via X-Forwarded-Host;
# without it, only the genuine Host header is trusted (spoofing guard,
# spec §7.5). Leave empty on the DO-native MVP path — nothing is
# edge-trusted and X-Forwarded-Host is always ignored.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EDGE_TRUST_SECRET=

# DO App Platform API access for automatic white-label domain sync:
# domain verify → registered on the app (DO provisions the cert);
# revocation sweep → removed from the app. Token needs apps read/write.
# Leave blank to manage app domains by hand in the DO console instead.
DO_API_TOKEN=
DO_APP_ID=

# Optional override for the CNAME target handed to customers registering a
# DO-native custom domain. When blank it is derived from the DO API (the
# app's <app-id>.ondigitalocean.app alias) if DO_API_TOKEN/DO_APP_ID are set.
DO_APP_DOMAIN_ALIAS=

# Hostname of the Phase-3 white-label droplet (droplet-edge dnsInstructions).
WHITELABEL_DROPLET_HOST=portal-router.openpartner.dev
