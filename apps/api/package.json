{
  "name": "@openpartner/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OpenPartner core API. Events ingest, identity stitching, attribution, payouts.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "openapi:update": "vitest run src/__tests__/openapi.test.ts -u"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "8.5.0",
    "@aws-sdk/client-s3": "^3.1154.0",
    "@openpartner/db": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "croner": "^10.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.0.0",
    "ipaddr.js": "^2.2.0",
    "knex": "^3.3.0",
    "maxmind": "^4.3.29",
    "nodemailer": "^10.0.6",
    "pg": "^8.23.1",
    "pino": "^9.4.0",
    "pino-http": "^9.0.0",
    "stripe": "^20.4.1",
    "ua-parser-js": "^2.0.10",
    "ulid": "^2.3.0",
    "undici": "^6.29.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "supertest": "^7.3.1",
    "tsx": "^4.19.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.12"
  }
}
