# Rendered at container start from /etc/nginx/templates/default.conf.template
# by the nginx:alpine entrypoint. API_UPSTREAM defaults to the compose
# service name; override for Fly / standalone deployments.

# TLS terminates at the deployment proxy; the portal receives plain HTTP.
# Preserve only recognized schemes, falling back to the local connection.
# Expose this container through a proxy that overwrites client-supplied headers.
map $http_x_forwarded_proto $api_forwarded_proto {
    default $scheme;
    http http;
    https https;
}

server {
    listen       8080 default_server;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # Gzip on for text assets — helps the JS bundle + CSS.
    gzip             on;
    gzip_comp_level  5;
    gzip_types       text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length  512;

    # Long cache for hashed static assets, no-cache for index.html so
    # new builds are seen immediately.
    location ~ \.(js|css|svg|woff2|png|jpg|gif|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # No site may frame the portal, this one included: a framed sign-in or
    # magic-link page can be overlaid and clicked through (clickjacking).
    # Nothing embeds the portal; its own iframes are outbound video players.
    # X-Frame-Options covers browsers without CSP frame-ancestors.
    #
    # add_header is inherited only by a location that declares none of its
    # own, so each location that answers with HTML repeats the pair: this
    # one (every SPA route lands here via try_files) and the fallback below.
    # /api/ declares none and stays that way, so the API's helmet headers
    # pass through without a second, conflicting copy from nginx.
    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
        add_header X-Frame-Options "DENY" always;
    }

    # Proxy /api/* to the API service. The API's own /api prefix is
    # stripped so the API continues to see /attribution/events etc.
    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $api_forwarded_proto;
        proxy_read_timeout 30s;
    }

    # SPA fallback — every non-asset, non-/api URL serves index.html so
    # react-router owns client-side routing.
    location / {
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
        add_header X-Frame-Options "DENY" always;
        try_files $uri /index.html;
    }
}
