# Rendered at container start from /etc/nginx/templates/default.conf.template
# by the nginx:alpine entrypoint. API_UPSTREAM defaults to the compose
# service name; override for Fly / standalone deployments.

server {
    listen       8080 default_server;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # Gzip on for text assets — helps the JS bundle + CSS.
    gzip             on;
    gzip_comp_level  5;
    gzip_types       text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length  512;

    # Long cache for hashed static assets, no-cache for index.html so
    # new builds are seen immediately.
    location ~ \.(js|css|svg|woff2|png|jpg|gif|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Proxy /api/* to the API service. The API's own /api prefix is
    # stripped so the API continues to see /attribution/events etc.
    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # SPA fallback — every non-asset, non-/api URL serves index.html so
    # react-router owns client-side routing.
    location / {
        try_files $uri /index.html;
    }
}
